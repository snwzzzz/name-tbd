{
  "$comment": "The one registry of widget types, read by the frontend (editor and exported runtime) and the backend. A widget is added here and as a component in the frontend (see widget-registry.constants.ts). Prop types beyond string/number/color/boolean/select/textarea have their own editor (PROP_EDITORS).",
  "version": 1,
  "categories": [
    { "id": "basic", "label": "Basic" },
    { "id": "actions", "label": "Actions" },
    { "id": "navigation", "label": "Navigation" },
    { "id": "data", "label": "Data" },
    { "id": "layout", "label": "Layout" }
  ],
  "widgets": [
