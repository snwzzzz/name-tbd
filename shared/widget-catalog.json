        { "key": "columns", "type": "columns", "label": "Columns", "group": "Data", "default": "[]" },
        { "key": "title", "type": "string", "label": "Title", "group": "Display", "default": "" },
        { "key": "maxRows", "type": "number", "label": "Max rows", "group": "Display", "default": "10" },
        { "key": "showHeader", "type": "boolean", "label": "Show header", "group": "Display", "default": "true" },
        { "key": "striped", "type": "boolean", "label": "Striped rows", "group": "Display", "default": "false" },
        { "key": "textSize", "type": "select", "label": "Text size", "group": "Display", "default": "Normal", "options": ["Small", "Normal", "Large", "Title", "Headline"] },
        { "key": "background", "type": "color", "label": "Background", "group": "Style", "default": "" },
        { "key": "headerBackground", "type": "color", "label": "Header background", "group": "Style", "default": "" },
        { "key": "headerColor", "type": "color", "label": "Header text color", "group": "Style", "default": "" },
        { "key": "multiSelect", "type": "boolean", "label": "Multi-select rows", "group": "Behavior", "default": "false" }
