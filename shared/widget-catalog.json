      "size": { "w": 24, "h": 12, "minW": 12, "minH": 7 },
      "resizable": true,
      "props": [
        { "key": "dataSourceId", "type": "dataSource", "label": "Data source (for its fields)", "group": "Data", "default": "" },
        { "key": "columns", "type": "columns", "label": "Fields", "group": "Data", "default": "[]" },
