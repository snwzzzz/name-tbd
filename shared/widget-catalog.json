      "type": "label",
      "name": "Text Label",
      "icon": "type",
      "category": "basic",
      "keywords": ["text", "heading", "paragraph"],
      "size": { "w": 8, "h": 3, "minW": 3, "minH": 1 },
      "resizable": true,
      "props": [
        { "key": "text", "type": "string", "label": "Text", "default": "New Label", "group": "Content" },
        { "key": "color", "type": "color", "label": "Color", "default": "#242424", "group": "Style" },
        { "key": "textSize", "type": "select", "label": "Text size", "group": "Style", "default": "Normal", "options": ["Small", "Normal", "Large", "Title", "Headline"] }
      ]
    },
    {
      "type": "input",
      "name": "Input",
      "icon": "text-cursor-input",
