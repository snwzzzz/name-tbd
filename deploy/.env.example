# Copy to deploy/.env (never commit that file) and fill in.

# The site's domain; its DNS must point to this server. Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=staging.example.com
ACME_EMAIL=you@example.com

DATABASE_PASSWORD=change-me

# Shared by the backend and the flow sidecar (any long random text)
FLOW_SIDECAR_TOKEN=change-me-too

# Encrypts the credentials of live data connections (databases, APIs, Google, Microsoft):
#   openssl rand -base64 32
# Keep it safe: without it stored credentials can't be read. To rotate, set the new one here and the old one as
# DATA_OLD_ENCRYPTION_KEYS=k1:<old key> (and DATA_ENCRYPTION_KEY_ID=k2 for the new one).
DATA_ENCRYPTION_KEY=

# Sign-in. Redirect URIs to register: https://<SITE_ADDRESS>/login/oauth2/code/google and …/microsoft
# The same apps connect Google Sheets and Microsoft 365 as data: also register
# https://<SITE_ADDRESS>/api/connections/oauth/google/callback and …/microsoft/callback, and enable the
# Google Sheets API (Google) or grant Files.ReadWrite.All and Sites.ReadWrite.All (Microsoft).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Error tracking (optional): one Sentry project for the backend, one for the editor
SENTRY_DSN_BACKEND=
SENTRY_DSN_EDITOR=
SENTRY_ENVIRONMENT=staging
